# KernelSU Action -- build profile (violet / Redmi Note 7 Pro)
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Base = vendor/violet_defconfig from MiCode/Xiaomi_Kernel_OpenSource @ violet-q-oss
# (Linux 4.14.117, ALL device drivers: audio/WiFi/fingerprint/touch enabled).
# We only ADD the -perf optimization on top (stock defaults to -Os).
#
# NOTE on packaging:
#   AnyKernel3 CANNOT flash violet. violet's stock boot.img has no real
#   ramdisk in the boot partition (the ramdisk slot holds an AVB0 header), so
#   AK3's unpack_ramdisk() aborts with "No ramdisk found to unpack".
#   Therefore we repack the new kernel straight into the stock boot image
#   and publish a flashable boot.img (fastboot flash boot).

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=violet-q-oss
KERNEL_CONFIG=vendor/violet_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=violet-q-oss

ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# =============================================================== KernelSU ===
# Build WITHOUT KernelSU (plain kernel).
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# Free-form defconfig lines, space or newline separated.
# Switch stock (-Os) to performance (-O2) build. The two are a Kconfig choice,
# so we explicitly disable -Os to avoid ambiguity.
EXTRA_DEFCONFIG=CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y CONFIG_CC_OPTIMIZE_FOR_SIZE=n

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false

# Repack a boot.img around the new kernel. SOURCE_BOOT_IMAGE must be a direct
# link to a bootable image for the same device and ROM.
# This is the ONLY usable packaging route for violet (see note at the top).
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/weimingming888/KernelSU_Action/releases/download/violet-q-stock-boot/violet-q-stock-boot.img

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=false
