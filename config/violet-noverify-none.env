# Redmi Note 7 Pro (violet) -- Xiaomi official Android 10 (Q) kernel source
# Non-GKI: Linux 4.14.117, vendor defconfig, Image.gz-dtb
# Source: MiCode/Xiaomi_Kernel_OpenSource @ violet-q-oss (2021-02-04)

CONFIG_ENV=config/violet-noverify-none.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=violet-q-oss
KERNEL_CONFIG=vendor/violet_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=violet-q-oss
ADD_LOCALVERSION_TO_FILENAME=false

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

EXTRA_CMDS:
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =============================================================== KernelSU ===
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_CC_STACKPROTECTOR_NONE=y CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC=n CONFIG_MODVERSIONS=n CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_SHA512=n CONFIG_LOCALVERSION_AUTO=n CONFIG_LOCALVERSION="-perf-g288905b"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=false

# No module verification: stock vermagic + MODVERSIONS/SIG off.

# Pure OSS kernel + stock vermagic/no verification, NO KernelSU.
